# Copy to .env and adjust values for your environment.
# For production, prefer immutable image digests.
# =============================================================================
# Image references
# =============================================================================

# Main Caddy WAF image (pin to a digest in production for deterministic deployments)
CADDY_WAF_IMAGE=ghcr.io/miguel-devops/caddy-waf:latest

# Optional demo backend for local validation (remove in production)
EXAMPLE_APP_IMAGE=containous/whoami:latest

# =============================================================================
# Caddy runtime
# =============================================================================

# Domain handled by Caddy (use your real FQDN in production)
SITE_ADDRESS=localhost

# Upstream backend target (service:port in Docker, or host:port for bare-metal)
BACKEND_UPSTREAM=example-app:80

# Configuration adapter to use (caddyfile is the default)
CADDY_ADAPTER=caddyfile

# =============================================================================
# TLS / ACME
# =============================================================================

# ACME email for Let's Encrypt certificate notifications (required in production)
ACME_EMAIL=
